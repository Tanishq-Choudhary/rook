{
  "uid": "rook-overview",
  "title": "Rook overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "rook"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs by state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (rook_jobs)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Step outcomes per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(rook_job_steps_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Step duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, state) (rate(rook_job_step_duration_seconds_bucket[5m])))",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rook_outbox_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "rook_outbox_oldest_age_seconds",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dead letters open",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rook_dead_letters_open",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Workers alive",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rook_workers_alive)",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Claims and lost leases",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reclaimed) (rate(rook_job_claims_total[5m])) * 60",
          "legendFormat": "claims reclaimed={{reclaimed}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(rook_job_lease_lost_total[5m])) * 60",
          "legendFormat": "leases lost"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Source polls",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(rook_source_polls_total[15m])) * 60",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests turned away",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(rook_http_rejected_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Change sets and events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rook_change_sets_total[1h])) * 3600",
          "legendFormat": "change sets per hour"
        },
        {
          "refId": "B",
          "expr": "sum(rate(rook_change_events_total[1h])) * 3600",
          "legendFormat": "events per hour"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Fanout",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rook_fanout_messages_total[5m])) * 60",
          "legendFormat": "messages"
        },
        {
          "refId": "B",
          "expr": "sum(rate(rook_fanout_jobs_total[5m])) * 60",
          "legendFormat": "jobs created"
        },
        {
          "refId": "C",
          "expr": "sum(rate(rook_fanout_failures_total[5m])) * 60",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Open event streams",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rook_api_streams_open)",
          "legendFormat": "streams"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Verifications and their duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(rook_verifications_total[15m])) * 60",
          "legendFormat": "{{result}} per minute"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rook_verification_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 seconds"
        }
      ]
    }
  ]
}